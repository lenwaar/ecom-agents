.env
*.key
.DS_Store
__pycache__/
.claude/settings.local.json

# Journal en direct de Claude Code (lu par Cowork sur le PC)
coordination/journal-direct.md
coordination/journal-direct.jsonl

# Studio vidéo (synchro n°12)
studio/video/.cache/
studio/video/_vendor/
studio/video/node_modules/
*.wav
# Les MP4 de plus de 20 Mo ne peuvent pas être filtrés par taille dans .gitignore : brouillons hors Git
medias/brouillons/
studio/video/**/renders/
studio/video/**/.hyperframes/

# Studio en direct (qg/studio, synchro n°13)
qg/studio/node_modules/

# Base de données de l'entreprise : données clients, jamais dans Git (RGPD)
donnees/*.db
donnees/sauvegardes/
donnees/imports/

# Boutique (V1) : vraies commandes importées depuis Stripe, jamais dans Git.
# Versionnés : data/commandes.vide.json (modèle vide lu par défaut) et data/commandes.exemple.json (format fictif).
data/commandes.json
# Exports bruts (Stripe ou autre) : données personnelles, jamais dans Git (audit conformite-qa M7).
data/*.csv
data/imports/
# Boucle marketing (V2-3) : posts reliés aux vraies commandes et décisions locales de l'humain, jamais dans Git.
# Versionnés : data/posts.vide.json, data/file-marketing.vide.json (modèles vides lus par défaut)
# et data/posts.exemple.json, data/file-marketing.exemple.json (formats fictifs, jamais lus).
data/posts.json
data/file-marketing.json
