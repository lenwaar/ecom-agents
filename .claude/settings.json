{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/tools/journal_claude.py\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/tools/journal_claude.py\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/tools/journal_claude.py\"", "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/tools/journal_claude.py\"", "timeout": 10 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/tools/journal_claude.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
