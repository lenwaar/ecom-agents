---
/**
 * Dégradés laiton et bois du prototype v2, partagés par tous les SVG de l'accueil.
 * SVG de taille nulle (pas display:none, sinon les dégradés ne s'appliquent pas).
 */
---

<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="degrade-laiton" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#E9CF93"></stop>
      <stop offset=".45" stop-color="#C8A15A"></stop>
      <stop offset="1" stop-color="#7A5A2C"></stop>
    </linearGradient>
    <linearGradient id="degrade-bois" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#E2C496"></stop>
      <stop offset="1" stop-color="#A47B4A"></stop>
    </linearGradient>
    <linearGradient id="degrade-planche" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E8CFA4"></stop>
      <stop offset="1" stop-color="#C9A472"></stop>
    </linearGradient>
    <radialGradient id="degrade-halo" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#C8A15A" stop-opacity=".55"></stop>
      <stop offset="1" stop-color="#C8A15A" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
</svg>
