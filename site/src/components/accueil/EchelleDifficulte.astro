---
/**
 * 8. Échelle de difficulté (§4.1.8). Définitions et chiffres calculés depuis le catalogue publié
 * (lib/catalogue.ts) ; le niveau est toujours écrit en texte, la jauge a un libellé (role="img").
 * Animation (scripts/accueil.ts) : segments qui se remplissent un à un, colonnes en cascade ;
 * survol ou focus : colonne −4 px, petit engrenage qui tourne de 90°, vignettes 1,03 (CSS).
 * Sans animation / sans JS : jauges remplies, tout visible.
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { getProduitsPublies } from '../../lib/donnees';
import { INTRO_ECHELLE, NIVEAUX, cheminVue } from '../../lib/catalogue';
import { texteHeures } from '../../lib/accueil';
import { traceEngrenage } from '../../lib/engrenages';

const produits = await getProduitsPublies();
const colonnes = NIVEAUX.map((n) => {
  const liste = produits.filter((p) => p.data.difficulte === n.slug);
  const min = liste.length ? Math.min(...liste.map((p) => p.data.temps_assemblage_heures_min)) : 0;
  const max = liste.length ? Math.max(...liste.map((p) => p.data.temps_assemblage_heures_max)) : 0;
  return { ...n, liste, exemples: liste.slice(0, 2), heures: liste.length ? texteHeures(min, max) : null, jauge: [1, 2, 3].map((i) => i <= n.rang) };
}).filter((c) => c.liste.length > 0);
const engrenage = traceEngrenage(10, 7.2, 1.6);
---

<section aria-labelledby="titre-echelle" class="conteneur py-20 md:py-28">
  <p class="kicker text-laiton-fonce" data-revele="bloc">Échelle de difficulté</p>
  <h2 id="titre-echelle" class="titre-serif mt-5 text-[44px] leading-none md:text-[clamp(44px,5.4vw,76px)]" data-revele="titre">
    <span data-ligne class="block overflow-hidden pb-[0.08em]"><span class="block">Facile, moyen,</span></span>
    <span data-ligne class="block overflow-hidden pb-[0.08em]"><span class="block"><em>expert.</em></span></span>
  </h2>
  <p class="mt-5 max-w-[560px] text-[16px] text-gris" data-revele="bloc">{INTRO_ECHELLE}</p>

  <ul class="mt-12 grid gap-4 lg:grid-cols-3" data-revele="cartes" data-echelle>
    {
      colonnes.map((c) => (
        <li class="colonne-niveau group flex flex-col rounded-[22px] border border-bordure bg-carte p-6 transition-[transform,box-shadow] duration-400 ease-sortie md:p-7">
          <div class="flex items-center justify-between">
            <span role="img" aria-label={`Niveau ${c.libelle.toLowerCase()}, ${c.rang} sur 3`} class="flex gap-1.5">
              {c.jauge.map((plein) => (
                <span class="block h-2 w-[34px] overflow-hidden rounded-full bg-[#EFECE8]">
                  {plein && <b data-jauge-segment class="block h-full origin-left bg-laiton-fonce" />}
                </span>
              ))}
            </span>
            <svg viewBox="-12 -12 24 24" width="20" height="20" aria-hidden="true" class="engrenage-niveau text-laiton-fonce">
              <path d={engrenage} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" fill-rule="evenodd" />
            </svg>
          </div>
          <h3 class="titre-serif mt-6 text-[34px] leading-none">{c.libelle}</h3>
          <p class="mt-3 text-[15px] text-gris">{c.definition}</p>
          <p class="mt-4 text-[14px] font-medium text-gris-fort">
            {c.heures} dans notre catalogue · {c.liste.length} modèle{c.liste.length > 1 ? 's' : ''}
          </p>
          <ul class="mt-5 grid grid-cols-2 gap-3">
            {c.exemples.map((p) => (
              <li>
                <a href={`/maquettes/${p.data.slug}/`} class="vignette block overflow-hidden rounded-[14px] border border-bordure">
                  <img
                    src={cheminVue(p.data.slug, 'face', 800)}
                    width="800"
                    height="1000"
                    alt={p.data.vues.face.alt}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/5] w-full object-cover transition-transform duration-600 ease-sortie"
                    style="background: radial-gradient(70% 60% at 50% 40%, #f4eee2, #e9e2d3);"
                  />
                  <span class="block px-2.5 py-2 text-[13px] font-medium leading-snug text-encre">{p.data.nom_court}</span>
                </a>
              </li>
            ))}
          </ul>
          <a
            href={`/maquettes/niveau/${c.slug}/`}
            class="mt-6 inline-flex min-h-11 items-center gap-2 self-start text-[15px] font-medium text-bleu-nuit underline-offset-4 hover:underline"
          >
            Voir les modèles {c.libelle.toLowerCase() === 'facile' ? 'faciles' : c.libelle.toLowerCase() === 'moyen' ? 'de niveau moyen' : 'experts'}
            <ArrowRight size={16} stroke-width={1.75} aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .engrenage-niveau {
    transition: transform 600ms var(--courbe-sortie);
  }
  @media (hover: hover) {
    .colonne-niveau:hover,
    .colonne-niveau:focus-within {
      transform: translateY(-4px);
      box-shadow: 0 18px 40px rgba(17, 24, 39, 0.08);
    }
    .colonne-niveau:hover .engrenage-niveau,
    .colonne-niveau:focus-within .engrenage-niveau {
      transform: rotate(90deg);
    }
    .vignette:hover img,
    .colonne-niveau:hover .vignette img {
      transform: scale(1.03);
    }
  }
  :global(html.js-anim) [data-echelle] [data-jauge-segment] {
    transform: scaleX(0);
  }
</style>
