---
/**
 * 3. « De la planche à l'objet » : comparateur avant / après (§4.1.3, audit N6).
 * - Sans JavaScript : deux figures côte à côte (empilées sur mobile) avec leurs légendes.
 * - Avec JavaScript (même sans animation) : image « après » superposée, découpée par clip-path ;
 *   pilotage au doigt, à la souris (glisser ou toucher une position) et au clavier par un
 *   input range (flèches ±5, Page ±10, Début / Fin), aria-valuetext « [n] % maquette montée ».
 *   touch-action: pan-y : le défilement vertical reste libre.
 * - Invitation unique à l'entrée (seulement avec animation, si personne n'a touché le comparateur).
 * Images : ambiance/comparateur-*.webp (studio-visuel), même caméra ; 800 × 1000 portrait sur mobile,
 * 1600 × 1000 sur ordinateur. Rendus de démonstration : légende obligatoire.
 */
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { getProduitsPublies } from '../../lib/donnees';
import { formatHeures } from '../../lib/catalogue';
import { getReglagesAccueil, produitParSlug } from '../../lib/accueil';

const reglages = await getReglagesAccueil();
const produit = produitParSlug(await getProduitsPublies(), reglages.produit_comparateur, 'produit_comparateur');
const p = produit.data;
const pieces = typeof p.nombre_pieces === 'number' ? `${p.nombre_pieces} pièces, ` : '';
const temps = formatHeures(p.temps_assemblage_heures_min, p.temps_assemblage_heures_max).replace(' h', ' heures');

const images = [
  { cle: 'avant', fichier: 'comparateur-planches', legende: 'Avant : les planches', etiquette: 'Avant' },
  { cle: 'apres', fichier: 'comparateur-monte', legende: 'Après : la maquette montée', etiquette: 'Après' },
];
---

<section aria-labelledby="titre-comparateur" class="registre-sombre relative bg-nuit py-24 text-creme md:py-36">
  <div class="conteneur grid items-center gap-10 lg:grid-cols-[.9fr_1.1fr] lg:gap-[5vw]">
    <div>
      <p class="kicker text-laiton" data-revele="bloc">Avant, après</p>
      <h2 id="titre-comparateur" class="titre-serif mt-5 text-[44px] leading-none md:text-[clamp(44px,5.4vw,76px)]" data-revele="titre">
        <span data-ligne class="block overflow-hidden pb-[0.08em]"><span class="block">De la planche</span></span>
        <span data-ligne class="block overflow-hidden pb-[0.08em]"><span class="block"><em>à l'objet.</em></span></span>
      </h2>
      <p class="mt-6 max-w-[460px] text-[16px] leading-[1.65] text-creme-secondaire" data-revele="bloc">
        À gauche, ce que vous recevez. À droite, ce que vous aurez construit : {p.nom_court}, {pieces}{temps} d'assemblage.
      </p>
      <p class="mt-8" data-revele="bloc">
        <a href={`/maquettes/${p.slug}/`} class="group inline-flex min-h-12 items-center gap-2.5 rounded-full border border-bordure-sombre px-6 text-[15px] font-medium transition-colors hover:border-laiton hover:text-laiton">
          Voir cette maquette
          <ArrowRight size={18} stroke-width={1.75} aria-hidden="true" class="transition-transform group-hover:translate-x-[3px]" />
        </a>
      </p>
    </div>

    <div data-revele="cadre">
      <div data-comparateur class="comparateur grid gap-4 sm:grid-cols-2" style="--pos: 50%;">
        {
          images.map((img) => (
            <figure class={`image-${img.cle} m-0`}>
              <picture class="block">
                <source media="(min-width: 768px)" srcset={`/ambiance/${img.fichier}-1600.webp`} width="1600" height="1000" />
                <img
                  src={`/ambiance/${img.fichier}-800.webp`}
                  width="800"
                  height="1000"
                  alt={img.cle === 'avant' ? `Planches de bois de la maquette ${p.nom_court}, posées à plat sur un bureau` : `La maquette ${p.nom_court} une fois montée, au-dessus du même bureau`}
                  loading="lazy"
                  decoding="async"
                  class="block aspect-[4/5] w-full rounded-[20px] object-cover md:aspect-[16/10]"
                  draggable="false"
                />
              </picture>
              <figcaption class="mt-2 text-[14px] text-creme-secondaire">
                <span class="legende">{img.legende}</span>
                <span class="etiquette" aria-hidden="true">{img.etiquette}</span>
              </figcaption>
            </figure>
          ))
        }
        <div class="poignee" hidden aria-hidden="true">
          <span class="filet"></span>
          <span class="pastille">
            <ChevronLeft size={18} stroke-width={1.75} />
            <ChevronRight size={18} stroke-width={1.75} />
          </span>
        </div>
        <input
          id="curseur-comparateur"
          type="range"
          min="0"
          max="100"
          step="5"
          value="50"
          hidden
          aria-label="Comparer les planches et la maquette montée"
          aria-valuetext="50 % maquette montée"
          class="curseur"
        />
      </div>
      <p class="mt-3 text-[13px] text-creme-secondaire">{p.demo ? 'Rendu 3D de démonstration.' : 'Photos du produit réel.'}</p>
    </div>
  </div>
</section>

<script>
  import { initialiserComparateurs } from '../../scripts/comparateur';
  initialiserComparateurs();
</script>

<style>
  .etiquette {
    display: none;
  }
  /* Mode comparateur (posé par le script, avec ou sans animation). */
  .comparateur.actif {
    position: relative;
    display: block;
    border-radius: 20px;
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
    cursor: ew-resize;
    aspect-ratio: 4 / 5;
    background: #0a0f1a;
  }
  @media (min-width: 768px) {
    .comparateur.actif {
      aspect-ratio: 16 / 10;
    }
  }
  .comparateur.actif figure {
    position: absolute;
    inset: 0;
  }
  .comparateur.actif picture {
    height: 100%;
  }
  .comparateur.actif img {
    border-radius: 0;
    height: 100%;
    aspect-ratio: auto;
  }
  .comparateur.actif .image-apres {
    clip-path: inset(0 0 0 var(--pos));
  }
  .comparateur.actif figcaption {
    margin: 0;
  }
  .comparateur.actif .legende {
    display: none;
  }
  .comparateur.actif .etiquette {
    display: inline-block;
    position: absolute;
    bottom: 16px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(10, 15, 26, 0.72);
    color: var(--texte-sur-nuit);
    font-size: 13px;
    font-weight: 500;
    transition: opacity 200ms;
  }
  .comparateur.actif .image-avant .etiquette {
    left: 16px;
  }
  .comparateur.actif .image-apres .etiquette {
    right: 16px;
  }
  .comparateur.actif .etiquette.estompee {
    opacity: 0;
  }
  .poignee {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 0;
    pointer-events: none;
  }
  .filet {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1px;
    width: 2px;
    background: var(--texte-sur-nuit);
  }
  .pastille {
    position: absolute;
    top: 50%;
    left: 0;
    width: 48px;
    height: 48px;
    translate: -50% -50%;
    display: grid;
    grid-auto-flow: column;
    place-content: center;
    border-radius: 999px;
    background: var(--texte-sur-nuit);
    color: var(--fond-nuit);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: transform 200ms var(--courbe-sortie);
  }
  .comparateur.actif:has(.curseur:focus-visible) .pastille {
    outline: 2px solid var(--accent-laiton);
    outline-offset: 3px;
  }
  .comparateur.actif.glisse .pastille {
    transform: scale(1.08);
  }
  .curseur {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
</style>
