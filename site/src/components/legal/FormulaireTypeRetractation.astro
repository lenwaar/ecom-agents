---
/**
 * Formulaire type de rétractation (annexe à l'article R221-1 du Code de la consommation).
 * Utilisé en annexe des CGV et sur /renoncer-au-contrat/ (§6.2 et §6.4 de la spécification v2).
 * Texte reproduit à contrôler mot pour mot avec Légifrance par conformite-qa avant publication.
 * Coordonnées du vendeur : boutique.yaml (=> [À VALIDER] tant qu'elles manquent).
 */
import Valeur from '../ui/Valeur.astro';
import AValider from '../ui/AValider.astro';
import { getBoutique } from '../../lib/donnees';

const b = await getBoutique();
---

<div class="mt-4 rounded-carte border border-bordure bg-carte p-5 text-[15px] md:p-6">
  <p class="!mt-0 font-semibold">Formulaire de rétractation</p>
  <p>(Veuillez compléter et renvoyer le présent formulaire uniquement si vous souhaitez vous rétracter du contrat.)</p>
  <p>
    À l'attention de <Valeur v={b.vendeur.nom_ei} note="Prénom Nom EI" />, {b.nom_commercial},
    <Valeur v={b.vendeur.adresse} note="adresse postale" />, <Valeur v={b.vendeur.email} note="email de la boutique" /> :
  </p>
  <p>
    Je/Nous (*) vous notifie/notifions (*) par la présente ma/notre (*) rétractation du contrat portant sur la vente du bien (*)/pour la prestation de services (*) ci-dessous :
  </p>
  <ul class="!list-none !pl-0">
    <li>Commandé le (*)/reçu le (*) :</li>
    <li>Nom du (des) consommateur(s) :</li>
    <li>Adresse du (des) consommateur(s) :</li>
    <li>Signature du (des) consommateur(s) (uniquement en cas de notification du présent formulaire sur papier) :</li>
    <li>Date :</li>
  </ul>
  <p>(*) Rayez la mention inutile.</p>
  <p class="text-[14px]">
    <AValider>texte à contrôler mot pour mot avec l'annexe à l'article R221-1 sur Légifrance ; version PDF imprimable à fournir</AValider>
  </p>
</div>
