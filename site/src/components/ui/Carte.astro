---
/**
 * Carte (§4.0) : fond blanc, bordure fine, rayon 18 px, ombre légère au survol seulement.
 * Avec `href`, la carte entière est un seul lien (libellé accessible via `libelle`).
 * La carte produit (image 4:5, prix, badges) sera construite sur cette base à l'étape 2.
 */
interface Props {
  href?: string;
  libelle?: string;
  registre?: 'clair' | 'sombre';
  class?: string;
}

const { href, libelle, registre = 'clair', class: classe } = Astro.props;

const base =
  registre === 'clair'
    ? 'rounded-carte border border-bordure bg-carte text-encre'
    : 'rounded-carte border border-bordure-sombre bg-nuit-2 text-creme';
const interactif =
  'block transition-[transform,box-shadow] duration-400 ease-sortie motion-safe:hover:-translate-y-1 hover:shadow-survol';
---

{
  href ? (
    <a href={href} aria-label={libelle} class={`${base} ${interactif} ${classe ?? ''}`}>
      <slot />
    </a>
  ) : (
    <div class={`${base} ${classe ?? ''}`}>
      <slot />
    </div>
  )
}
