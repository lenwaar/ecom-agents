---
/**
 * Caractéristiques (§5.2 bloc 11) : niveau (avec la définition de notre échelle), temps,
 * nombre de pièces, dimensions monté, poids, matériaux, mécanisme, colle, outils.
 * - Produit de démonstration : une ligne dont la valeur est « À VÉRIFIER » n'est pas affichée
 *   (knowledge/decisions.md) ; aucun marqueur visible.
 * - Vrai produit : une valeur « À VÉRIFIER » bloque la construction (content.config.ts) ;
 *   par sécurité elle s'afficherait « [À VALIDER] ». Aucun chiffre inventé.
 */
import Donnee from './Donnee.astro';
import JaugeNiveau from './JaugeNiveau.astro';
import { LIBELLES_MECANISME, contientAVerifier, formatHeures, listeDemo, niveau } from '../../lib/catalogue';
import type { Produit } from '../../lib/donnees';

interface Props {
  produit: Produit;
}

const { produit } = Astro.props;
const p = produit.data;
const demo = p.demo;
const n = niveau(p.difficulte);

const ouiNon = (b: boolean) => (b ? 'Oui' : 'Non');
const dimensions = (d: { longueur: number; largeur: number; hauteur: number }) =>
  `${d.longueur} × ${d.largeur} × ${d.hauteur} cm (L × l × h)`;

/** Liste : en démonstration, éléments inconnus retirés ; liste vide d'origine = « Aucun ». */
function liste(valeurs: string[]): string[] | null {
  if (valeurs.length === 0) return ['Aucun'];
  if (!demo) return valeurs;
  const connues = listeDemo(valeurs);
  return connues.length > 0 ? connues : null;
}

type Ligne = { titre: string; v: unknown; note: string; format?: (x: any) => string } | { titre: string; liste: string[] | null; note: string };

const lignes: Ligne[] = [
  { titre: 'Nombre de pièces', v: p.nombre_pieces, note: 'nombre de pièces' },
  { titre: 'Dimensions une fois monté', v: p.dimensions_cm, note: 'dimensions', format: dimensions },
  { titre: 'Poids', v: p.poids_g, note: 'poids', format: (g: number) => `${g} g` },
  { titre: 'Matériaux', liste: p.materiaux.length === 0 ? null : liste(p.materiaux), note: 'matériaux' },
  { titre: 'Mécanisme', v: p.mecanisme, note: 'mécanisme', format: (m: string) => LIBELLES_MECANISME[m] ?? m },
  { titre: 'Colle nécessaire', v: p.colle_necessaire, note: 'colle', format: ouiNon },
  { titre: 'Outils nécessaires', liste: liste(p.outils_necessaires), note: 'outils nécessaires' },
  { titre: 'Outils fournis', liste: liste(p.outils_fournis), note: 'outils fournis' },
];

// Démonstration : on ne garde que les lignes dont la valeur est connue.
const visibles = lignes.filter((l) => {
  if (!demo) return true;
  if ('liste' in l) return l.liste !== null;
  return !contientAVerifier(l.v);
});
---

<section aria-labelledby="titre-caracteristiques">
  <h2 id="titre-caracteristiques" class="text-[22px] font-semibold md:text-[28px]">Caractéristiques</h2>
  <dl class="mt-4 divide-y divide-bordure border-y border-bordure text-[15px]">
    <div class="grid gap-1 py-3 sm:grid-cols-[200px_1fr] sm:gap-4">
      <dt class="font-medium text-gris-fort">Niveau</dt>
      <dd>
        <JaugeNiveau difficulte={p.difficulte} />
        <span class="mt-1 block text-gris">
          {n.definition}{' '}
          <a href={`/maquettes/niveau/${p.difficulte}/`} class="text-bleu-nuit underline underline-offset-4">
            Voir les modèles de niveau {n.libelle}
          </a>
        </span>
      </dd>
    </div>
    <div class="grid gap-1 py-3 sm:grid-cols-[200px_1fr] sm:gap-4">
      <dt class="font-medium text-gris-fort">Temps d'assemblage</dt>
      <dd>Environ {formatHeures(p.temps_assemblage_heures_min, p.temps_assemblage_heures_max)}</dd>
    </div>
    {
      visibles.map((l) => (
        <div class="grid gap-1 py-3 sm:grid-cols-[200px_1fr] sm:gap-4">
          <dt class="font-medium text-gris-fort">{l.titre}</dt>
          <dd>
            {'liste' in l ? (
              l.liste === null ? (
                <Donnee v="" note={l.note} />
              ) : (
                l.liste.map((x, i) => (
                  <Fragment>
                    {i > 0 && ', '}
                    <Donnee v={x} demo={demo} />
                  </Fragment>
                ))
              )
            ) : (
              <Donnee v={l.v} note={l.note} format={l.format} demo={demo} />
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
