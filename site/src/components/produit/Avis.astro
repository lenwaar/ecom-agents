---
/**
 * Avis clients d'un produit (data/avis.json).
 * Règle (CLAUDE.md) : un avis n'est affiché que si sa reference_commande correspond à une commande
 * « payee » de data/commandes.json pour ce produit (filtrage dans lib/produits-json.ts, les autres
 * sont ignorés avec un avertissement de construction). Aucun avis inventé, aucune étoile décorative :
 * la note est écrite en toutes lettres.
 */
import MessageSquare from '@lucide/astro/icons/message-square';
import BadgeCheck from '@lucide/astro/icons/badge-check';
import { avisVerifies } from '../../lib/produits-json';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const avis = avisVerifies(slug);
const formatDate = (d: string) => {
  const date = new Date(d);
  return Number.isNaN(date.getTime()) ? d : new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' }).format(date);
};
---

<section aria-labelledby="titre-avis" class="rounded-carte border border-bordure bg-carte p-5 md:p-6">
  <h2 id="titre-avis" class="flex items-center gap-2.5 text-[22px] font-semibold">
    <MessageSquare size={22} stroke-width={1.75} aria-hidden="true" class="text-laiton-fonce" />
    Avis clients
  </h2>
  {
    avis.length === 0 ? (
      <p class="mt-3 text-[15px] text-gris-fort">Aucun avis pour l'instant.</p>
    ) : (
      <Fragment>
        <p class="mt-3 flex gap-2 text-[14px] text-gris-fort">
          <BadgeCheck size={18} stroke-width={1.75} aria-hidden="true" class="mt-0.5 shrink-0 text-laiton-fonce" />
          <span>Chaque avis ci-dessous est lié à une commande vérifiée et payée sur notre boutique.</span>
        </p>
        <ul class="mt-5 flex flex-col gap-4">
          {avis.map((a) => (
            <li class="border-t border-bordure pt-4">
              <p class="text-[15px] font-semibold">Note : {a.note} sur 5</p>
              <blockquote class="mt-2 text-[15px]">{a.texte}</blockquote>
              <p class="mt-2 text-[14px] text-gris-fort">
                {a.auteur}, le {formatDate(a.date)} · commande vérifiée
              </p>
            </li>
          ))}
        </ul>
      </Fragment>
    )
  }
</section>
