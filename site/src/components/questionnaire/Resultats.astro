---
/**
 * Résultats de « Trouver ma maquette » sur les pages statiques (§4.1.7) : 1 à 3 cartes produit,
 * puces de raison factuelles, encadré « À offrir », liens « Modifier mes réponses » et
 * « Lien vers ce résultat ». Jamais « parfait pour vous » ni « meilleur choix ».
 */
import Gift from '@lucide/astro/icons/gift';
import Link from '@lucide/astro/icons/link';
import RotateCcw from '@lucide/astro/icons/rotate-ccw';
import Info from '@lucide/astro/icons/info';
import CarteProduit from '../produit/CarteProduit.astro';
import type { Produit } from '../../lib/donnees';
import { cheminEtape, libelleChoix, recommander, type Experience, type PourQui, type ProduitQuiz, type Temps } from '../../lib/questionnaire';

interface Props {
  produits: Produit[];
  quiz: ProduitQuiz[];
  pourQui: PourQui;
  experience: Experience;
  temps: Temps;
  messageCadeau: boolean;
}

const { produits, quiz, pourQui, experience, temps, messageCadeau } = Astro.props;
const { resultats, message } = recommander(quiz, pourQui, experience, temps);
const parSlug = new Map(produits.map((p) => [p.data.slug, p]));
const lienResultat = cheminEtape(pourQui, experience, temps);
---

<div>
  <h2 class="titre-serif text-[30px] leading-[1.1] md:text-[40px]">
    {resultats.length} maquette{resultats.length > 1 ? 's' : ''} <em>pour commencer.</em>
  </h2>
  <p class="mt-3 text-[15px] text-gris-fort">
    Vos réponses : {libelleChoix('pourQui', pourQui)} · {libelleChoix('experience', experience)} · {libelleChoix('temps', temps)}
  </p>
  {
    message && (
      <p class="mt-4 flex gap-2 rounded-[14px] bg-encart p-4 text-[15px]">
        <Info size={18} stroke-width={1.75} aria-hidden="true" class="mt-0.5 shrink-0 text-laiton-fonce" />
        {message}
      </p>
    )
  }
  <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      resultats.map((r) => {
        const produit = parSlug.get(r.produit.slug);
        return (
          produit && (
            <li class="flex flex-col gap-3">
              <ul class="flex flex-wrap gap-2" aria-label="Pourquoi cette suggestion">
                {r.raisons.map((raison) => (
                  <li class="rounded-full border border-bordure bg-carte px-3 py-1 text-[13px] font-medium">{raison}</li>
                ))}
              </ul>
              <CarteProduit produit={produit} niveauTitre="h3" />
            </li>
          )
        );
      })
    }
  </ul>
  {
    pourQui === 'offrir' && (
      <p class="mt-6 flex gap-3 rounded-[14px] border border-bordure bg-carte p-4 text-[15px]">
        <Gift size={20} stroke-width={1.75} aria-hidden="true" class="mt-0.5 shrink-0 text-laiton-fonce" />
        <span>
          À offrir : {messageCadeau && 'message cadeau possible au paiement · '}droit de rétractation de 14 jours à compter de la réception.
        </span>
      </p>
    )
  }
  <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-[15px]">
    <a href="/trouver-ma-maquette/" class="inline-flex min-h-11 items-center gap-2 font-medium text-bleu-nuit underline-offset-4 hover:underline">
      <RotateCcw size={16} stroke-width={1.75} aria-hidden="true" />
      Modifier mes réponses
    </a>
    <a href={lienResultat} class="inline-flex min-h-11 items-center gap-2 font-medium text-bleu-nuit underline-offset-4 hover:underline">
      <Link size={16} stroke-width={1.75} aria-hidden="true" />
      Lien vers ce résultat
    </a>
  </p>
</div>
