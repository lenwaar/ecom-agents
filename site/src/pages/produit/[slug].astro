---
/**
 * Page produit modèle /produit/<slug>/, construite depuis data/produits/<slug>.json (lib/produits-json.ts).
 * Démonstration : bandeau « Page de démonstration, produit non vendu » et noindex, nofollow
 * (prop noindex de la mise en page ; les autres pages ne changent pas). Le site n'a pas de sitemap.
 */
import type { GetStaticPaths } from 'astro';
import Info from '@lucide/astro/icons/info';
import Base from '../../layouts/Base.astro';
import FicheProduitJson from '../../components/produit/FicheProduitJson.astro';
import { chargerProduits, texteConnu, type ProduitJson } from '../../lib/produits-json';

export const getStaticPaths = (() =>
  chargerProduits().map((produit) => ({ params: { slug: produit.slug }, props: { produit } }))) satisfies GetStaticPaths;

const { produit } = Astro.props as { produit: ProduitJson };
const nom = texteConnu(produit.nom) ?? 'Produit';
const description = produit.demo
  ? 'Page de démonstration : produit non vendu, présenté comme modèle de fiche produit.'
  : (texteConnu(produit.description) ?? nom).slice(0, 155);
---

<Base titre={produit.demo ? `${nom} (démonstration)` : nom} description={description} noindex={produit.demo}>
  {
    produit.demo && (
      <div class="border-b border-bordure bg-encart" data-bandeau-demo>
        <p class="conteneur flex gap-2.5 border-l-[3px] border-laiton-fonce py-3 text-[15px] text-encre">
          <Info size={20} stroke-width={1.75} aria-hidden="true" class="mt-0.5 shrink-0 text-laiton-fonce" />
          <span>
            <strong>Page de démonstration, produit non vendu.</strong> Aucun prix n'est fixé et aucun paiement n'est possible.
          </span>
        </p>
      </div>
    )
  }
  <FicheProduitJson produit={produit} />
</Base>
