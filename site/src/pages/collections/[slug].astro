---
/**
 * Pages de collection /collections/[mecanique|vehicules|miniatures|pour-debuter|idees-cadeaux]/ (§4.3) :
 * héros cinématique animé, puis panneau clair : grille filtrable par niveau, « Ce qui les réunit »,
 * « Vous aimerez peut-être aussi » (moins de 3 modèles), autres collections, réassurance.
 * Filtres : sans JS, liens vers /maquettes/niveau/… ; avec JS, ils masquent les cartes et mettent
 * à jour ?niveau= dans l'adresse (aucun stockage).
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import HerosCollection from '../../components/collection/HerosCollection.astro';
import CarteCollection from '../../components/collection/CarteCollection.astro';
import GrilleProduits from '../../components/produit/GrilleProduits.astro';
import ReassuranceCompacte from '../../components/produit/ReassuranceCompacte.astro';
import DonneesStructurees from '../../components/produit/DonneesStructurees.astro';
import Valeur from '../../components/ui/Valeur.astro';
import { getProduitsPublies, type Produit } from '../../lib/donnees';
import {
  COLLECTIONS_PRINCIPALES,
  LIBELLES_MECANISME,
  NIVEAUX,
  collections,
  estConnu,
  produitsDeCollection,
  type SlugCollection,
} from '../../lib/catalogue';

export const getStaticPaths = (async () => {
  const produits = await getProduitsPublies();
  return collections(produits).map((collection) => ({ params: { slug: collection.slug }, props: { collection } }));
}) satisfies GetStaticPaths;

const { collection } = Astro.props;
const tous = await getProduitsPublies();
const produits = produitsDeCollection(tous, collection.slug);
const liste = collections(tous);

// Niveaux présents dans la collection (pas de filtre qui mène à une grille vide).
const niveauxPresents = NIVEAUX.filter((n) => produits.some((p) => p.data.difficulte === n.slug));

// 3. Ce qui les réunit : faits générés depuis les données, inconnues marquées.
const mecanismesConnus = [...new Set(produits.map((p) => p.data.mecanisme).filter((m) => estConnu(m)))].map(
  (m) => LIBELLES_MECANISME[m as string] ?? m,
);
const mecanismesInconnus = produits.filter((p) => !estConnu(p.data.mecanisme)).length;
const pieces = produits.map((p) => p.data.nombre_pieces);
const piecesConnues = pieces.every((x) => typeof x === 'number') ? (pieces as number[]) : null;

// Vous aimerez peut-être aussi : collection de moins de 3 modèles, 2 produits d'autres collections, même niveau.
const ids = new Set(produits.map((p) => p.id));
const niveauxCollection = new Set(produits.map((p) => p.data.difficulte));
const suggestions: Produit[] =
  produits.length < 3 ? tous.filter((p) => !ids.has(p.id) && niveauxCollection.has(p.data.difficulte)).slice(0, 2) : [];

// 4. Autres collections (les grandes collections, sauf celle-ci).
const autres = COLLECTIONS_PRINCIPALES.filter((s) => s !== collection.slug).map((s) => liste.find((c) => c.slug === s)!);
---

<Base titre={collection.titreSeo} description={collection.descriptionSeo} registre="sombre" animations>
  <HerosCollection collection={collection} produits={produits} />

  <div class="registre-clair relative z-[2] -mt-8 rounded-t-[32px] bg-papier text-encre">
    <div class="conteneur pt-14 pb-20 md:pt-20">
      <!-- 2. Grille produits -->
      <section aria-labelledby="titre-modeles">
        <h2 id="titre-modeles" class="titre-serif text-[36px] leading-none md:text-[52px]">
          Les {produits.length} <em>modèle{produits.length > 1 ? 's' : ''}.</em>
        </h2>
        {
          niveauxPresents.length > 1 && (
            <nav aria-label="Filtrer par niveau" class="-mx-[clamp(16px,4vw,48px)] mt-6 overflow-x-auto px-[clamp(16px,4vw,48px)]">
              <ul class="flex w-max gap-2 py-1" data-filtres-niveau>
                <li>
                  <a
                    href={`/collections/${collection.slug}/`}
                    data-filtre=""
                    aria-current="true"
                    class="puce inline-flex min-h-11 items-center rounded-full border border-bordure bg-carte px-4 text-[14px] font-medium"
                  >
                    Tous les niveaux
                  </a>
                </li>
                {niveauxPresents.map((n) => (
                  <li>
                    <a
                      href={`/maquettes/niveau/${n.slug}/`}
                      data-filtre={n.slug}
                      class="puce inline-flex min-h-11 items-center rounded-full border border-bordure bg-carte px-4 text-[14px] font-medium"
                    >
                      {n.libelle}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <p class="sr-only" aria-live="polite" data-annonce-filtre></p>
        <div class="mt-6">
          <GrilleProduits produits={produits} niveauTitre="h3" revele id="grille-collection" />
        </div>
      </section>

      <!-- Moins de 3 modèles : suggestions factuelles (même niveau), jamais « bientôt d'autres modèles ». -->
      {
        suggestions.length > 0 && (
          <section aria-labelledby="titre-suggestions" class="mt-16">
            <h2 id="titre-suggestions" class="text-[22px] font-semibold md:text-[28px]">
              Vous aimerez peut-être aussi
            </h2>
            <div class="mt-5">
              <GrilleProduits produits={suggestions} colonnesMax={3} />
            </div>
          </section>
        )
      }

      <!-- 3. Ce qui les réunit -->
      <section aria-labelledby="titre-reunit" class="mt-20">
        <h2 id="titre-reunit" class="titre-serif text-[34px] leading-none md:text-[44px]">
          Ce qui <em>les réunit.</em>
        </h2>
        <dl class="mt-8 grid gap-5 md:grid-cols-3" data-revele="cartes">
          <div class="rounded-carte border border-bordure bg-carte p-5">
            <dt class="text-[13px] font-medium tracking-[0.12em] text-gris-fort uppercase">Mécanisme</dt>
            <dd class="mt-2 text-[16px]">
              {mecanismesConnus.join(', ')}
              {mecanismesInconnus > 0 && (
                <Fragment>
                  {mecanismesConnus.length > 0 && ' · '}
                  <Valeur v="" note={`mécanisme de ${mecanismesInconnus} modèle${mecanismesInconnus > 1 ? 's' : ''}`} />
                </Fragment>
              )}
            </dd>
          </div>
          <div class="rounded-carte border border-bordure bg-carte p-5">
            <dt class="text-[13px] font-medium tracking-[0.12em] text-gris-fort uppercase">Nombre de pièces</dt>
            <dd class="mt-2 text-[16px]">
              {piecesConnues ? (
                Math.min(...piecesConnues) === Math.max(...piecesConnues) ? (
                  `${piecesConnues[0]} pièces`
                ) : (
                  `De ${Math.min(...piecesConnues)} à ${Math.max(...piecesConnues)} pièces`
                )
              ) : (
                <Valeur v="" note="nombre de pièces" />
              )}
            </dd>
          </div>
          <div class="rounded-carte border border-bordure bg-carte p-5">
            <dt class="text-[13px] font-medium tracking-[0.12em] text-gris-fort uppercase">Niveaux</dt>
            <dd class="mt-2 text-[16px]">{niveauxPresents.map((n) => n.libelle).join(', ')}</dd>
          </div>
        </dl>
      </section>

      <!-- 4. Autres collections -->
      <section aria-labelledby="titre-autres" class="mt-20">
        <h2 id="titre-autres" class="titre-serif text-[34px] leading-none md:text-[44px]">
          Autres <em>collections.</em>
        </h2>
        <ul
          class="-mx-[clamp(16px,4vw,48px)] mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto px-[clamp(16px,4vw,48px)] pb-2 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0"
          data-revele="cartes"
        >
          {
            autres.map((c) => (
              <li class="w-[80vw] max-w-[360px] shrink-0 snap-start md:w-auto md:max-w-none">
                <CarteCollection collection={c} produits={produitsDeCollection(tous, c.slug as SlugCollection)} />
              </li>
            ))
          }
        </ul>
      </section>

      <!-- 5. Réassurance compacte + « Trouver ma maquette » (si la page existe) -->
      <div class="mt-20">
        <ReassuranceCompacte />
      </div>
    </div>
  </div>

  <DonneesStructurees
    donnees={{
      '@type': 'CollectionPage',
      name: `${collection.nom} ${collection.ligneItalique}`,
      description: collection.descriptionSeo,
      url: `/collections/${collection.slug}/`,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: produits.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `/maquettes/${p.data.slug}/`, name: p.data.nom_court })),
      },
    }}
  />
</Base>

<style>
  .puce[aria-current='true'] {
    border-color: var(--action-bleu-nuit);
    background: var(--action-bleu-nuit);
    color: #fff;
  }
  .puce:not([aria-current='true']):hover {
    border-color: var(--accent-laiton-fonce);
    color: var(--accent-laiton-fonce);
  }
  :global([data-grille-produits] > li.sort) {
    display: none;
  }
</style>

<script>
  import { animerCollection } from '../../scripts/collection';
  animerCollection();

  // Filtre par niveau (avec JS) : masque les cartes, met à jour ?niveau= (replaceState, aucun stockage).
  const filtres = [...document.querySelectorAll<HTMLAnchorElement>('[data-filtres-niveau] [data-filtre]')];
  const cartes = [...document.querySelectorAll<HTMLElement>('#grille-collection > li')];
  const annonce = document.querySelector<HTMLElement>('[data-annonce-filtre]');
  const appliquer = (niveau: string, annoncer: boolean) => {
    let n = 0;
    cartes.forEach((c) => {
      const garde = !niveau || c.dataset.niveau === niveau;
      c.classList.toggle('sort', !garde);
      if (garde) n++;
    });
    filtres.forEach((f) => (f.dataset.filtre === niveau ? f.setAttribute('aria-current', 'true') : f.removeAttribute('aria-current')));
    const url = new URL(location.href);
    if (niveau) url.searchParams.set('niveau', niveau);
    else url.searchParams.delete('niveau');
    history.replaceState(null, '', url);
    if (annonce && annoncer) annonce.textContent = `${n} maquette${n > 1 ? 's' : ''} affichée${n > 1 ? 's' : ''}`;
  };
  filtres.forEach((f) =>
    f.addEventListener('click', (e) => {
      e.preventDefault();
      appliquer(f.dataset.filtre ?? '', true);
    }),
  );
  const depart = new URLSearchParams(location.search).get('niveau') ?? '';
  if (filtres.some((f) => f.dataset.filtre === depart && depart)) appliquer(depart, false);
</script>
